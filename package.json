{
  "name": "scroll-seamless",
  "version": "2.0.1",
  "type": "module",
  "description": "A high-performance, feature-rich seamless scrolling library supporting JavaScript, Vue 3, and React",
  "main": "dist/core/index.cjs.js",
  "module": "dist/core/index.esm.js",
  "types": "dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.esm.js",
      "require": "./dist/core/index.cjs.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.esm.js",
      "require": "./dist/vue/index.cjs.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.esm.js",
      "require": "./dist/react/index.cjs.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.esm.js",
      "require": "./dist/plugins/index.cjs.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.en.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --open",
    "build": "rollup -c rollup.config.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx,.vue",
    "format": "prettier --write 'src/**/*.{ts,tsx,vue}'",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test:run",
    "release": "npm publish",
    "release:beta": "npm publish --tag beta"
  },
  "keywords": [
    "scroll",
    "seamless",
    "marquee",
    "carousel",
    "vue",
    "react",
    "typescript",
    "performance",
    "virtual-scroll",
    "animation"
  ],
  "author": "huangchao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chao921125/scroll-seamless.git"
  },
  "bugs": {
    "url": "https://github.com/chao921125/scroll-seamless/issues"
  },
  "homepage": "https://github.com/chao921125/scroll-seamless#readme",
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/compiler-sfc": "^3.5.35",
    "eslint": "^9.39.4",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "^3.30.0",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-vue": "6.0.0-beta.11",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vitest": "^1.6.1",
    "vue": "^3.5.35"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
